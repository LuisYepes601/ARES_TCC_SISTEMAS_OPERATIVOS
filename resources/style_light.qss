/* =====================================================================
   Ares v3.0 — Tema Claro Premium
   Paleta: Blanco puro / Azul índigo / Grises cálidos
   Fuentes grandes, legibles, profesional
   ===================================================================== */

* { box-sizing: border-box; }

QMainWindow, QWidget {
    background-color: #f5f6fa;
    color: #1a1d2e;
    font-family: "Segoe UI", "SF Pro Text", "Inter", system-ui, sans-serif;
    font-size: 10pt;
}

/* ── Status bar top ── */
QWidget#TopStatusBar {
    background-color: #ffffff;
    border-bottom: 2px solid #e8eaf0;
}
QLabel#StatusBarLabel {
    color: #6b7280;
    font-size: 9.5pt;
    font-weight: 500;
}
#StatusSeparator { background-color: #e8eaf0; }

/* ── Sidebar ── */
QWidget#Sidebar {
    background-color: #1e2140;
    border-right: none;
}
#SidebarSeparator { background-color: #2a2f5a; }

QLabel#SidebarTitle {
    color: #ffffff;
    font-size: 18pt;
    font-weight: 800;
    letter-spacing: 5px;
}
QLabel#SidebarSubtitle {
    color: #4a5080;
    font-size: 8.5pt;
    font-weight: 500;
}
QLabel#SidebarUptime {
    color: #3a4070;
    font-size: 9pt;
    font-family: "Consolas", "SF Mono", monospace;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #6070a0;
    border: none;
    border-radius: 8px;
    padding: 11px 14px;
    text-align: left;
    font-size: 10pt;
    font-weight: 500;
}
QPushButton#NavButton:hover {
    background-color: #2a3060;
    color: #c0c8f0;
}
QPushButton#NavButton:checked {
    background-color: #3b4fd6;
    color: #ffffff;
    font-weight: 700;
    border-left: 3px solid #7c8ffc;
    padding-left: 11px;
}

/* ── Main content ── */
QStackedWidget#ContentStack { background-color: #f5f6fa; }

/* ── Menu bar ── */
QMenuBar {
    background-color: #ffffff;
    color: #374151;
    border-bottom: 1px solid #e5e7eb;
    font-size: 10pt;
}
QMenuBar::item:selected {
    background-color: #f3f4f6;
    border-radius: 4px;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 6px;
    font-size: 10pt;
}
QMenu::item { padding: 7px 20px; border-radius: 5px; color: #1f2937; }
QMenu::item:selected { background-color: #eef2ff; color: #3b4fd6; }
QMenu::separator { height: 1px; background-color: #f3f4f6; margin: 4px 8px; }

/* ── Buttons ── */
QPushButton {
    background-color: #ffffff;
    color: #374151;
    border: 1.5px solid #d1d5db;
    border-radius: 7px;
    padding: 6px 14px;
    min-width: 70px;
    font-size: 9.5pt;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #f9fafb;
    border-color: #6366f1;
    color: #4f46e5;
}
QPushButton:pressed { background-color: #eef2ff; }
QPushButton:disabled { background-color: #f9fafb; color: #9ca3af; border-color: #e5e7eb; }

QPushButton#DangerButton {
    background-color: #fff5f5;
    border-color: #fca5a5;
    color: #dc2626;
    font-weight: 600;
}
QPushButton#DangerButton:hover {
    background-color: #dc2626;
    color: #ffffff;
    border-color: #dc2626;
}

QPushButton#WarnButton {
    background-color: #fffbeb;
    border-color: #fcd34d;
    color: #d97706;
    font-weight: 600;
}
QPushButton#WarnButton:hover {
    background-color: #f59e0b;
    color: #ffffff;
    border-color: #f59e0b;
}

QPushButton#PrimaryButton {
    background-color: #4f46e5;
    border-color: #4f46e5;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#PrimaryButton:hover { background-color: #4338ca; border-color: #4338ca; }

QPushButton#ApplyButton {
    background-color: #f0fdf4;
    border-color: #86efac;
    color: #16a34a;
    font-weight: 600;
}
QPushButton#ApplyButton:hover { background-color: #16a34a; color: #ffffff; }

QPushButton#InfoButton {
    background-color: #eff6ff;
    border-color: #93c5fd;
    color: #2563eb;
    font-weight: 600;
}
QPushButton#InfoButton:hover { background-color: #2563eb; color: #ffffff; }

/* ── Line edits ── */
QLineEdit {
    background-color: #ffffff;
    border: 1.5px solid #d1d5db;
    border-radius: 7px;
    padding: 6px 11px;
    color: #111827;
    font-size: 10pt;
    selection-background-color: #c7d2fe;
}
QLineEdit:focus { border-color: #6366f1; }
QLineEdit:hover { border-color: #9ca3af; }
QLineEdit::placeholder { color: #9ca3af; }

/* ── Tables ── */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    gridline-color: #f3f4f6;
    alternate-background-color: #fafafa;
    selection-background-color: #eef2ff;
    selection-color: #1a1d2e;
    font-size: 10pt;
}
QTableWidget::item { padding: 5px 8px; border: none; }
QTableWidget::item:selected {
    background-color: #eef2ff;
    color: #1a1d2e;
}
QTableWidget::item:hover { background-color: #f5f3ff; }

QHeaderView { background-color: #f9fafb; }
QHeaderView::section {
    background-color: #f9fafb;
    color: #6b7280;
    padding: 8px 10px;
    border: none;
    border-right: 1px solid #f3f4f6;
    border-bottom: 2px solid #e5e7eb;
    font-size: 9pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
}
QHeaderView::section:first { border-top-left-radius: 10px; }
QHeaderView::section:last  { border-top-right-radius: 10px; }

/* ── GroupBox ── */
QGroupBox {
    background-color: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 12px;
    font-size: 9pt;
    font-weight: 700;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #9ca3af;
    background-color: #f5f6fa;
}

/* ── ComboBox / SpinBox ── */
QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1.5px solid #d1d5db;
    border-radius: 7px;
    padding: 5px 10px;
    color: #111827;
    font-size: 10pt;
    min-width: 80px;
}
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #6366f1; }
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: #9ca3af; }
QComboBox::drop-down { border: none; }
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    selection-background-color: #eef2ff;
    color: #111827;
    font-size: 10pt;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    background: #f9fafb;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #d1d5db;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #9ca3af; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: #f9fafb;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #d1d5db;
    border-radius: 4px;
}

/* ── Labels ── */
QLabel { color: #1a1d2e; font-size: 10pt; }
QLabel#PanelTitle { color: #111827; font-size: 14pt; font-weight: 700; }
QLabel#SectionLabel {
    color: #6b7280;
    font-size: 8.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}
QLabel#AlertCount { color: #9ca3af; font-size: 10pt; }
QLabel#ProcessCount { color: #9ca3af; font-size: 9.5pt; }
QLabel#EmptyAlertsLabel { color: #16a34a; font-size: 11pt; padding: 30px; }
QLabel#StatKey { color: #6b7280; font-size: 9pt; }
QLabel#StatVal { color: #111827; font-size: 11pt; font-weight: 600; }

/* ── Progress bars ── */
QProgressBar {
    background-color: #e5e7eb;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar#HealthBar {
    height: 10px;
    border-radius: 5px;
    background-color: #e5e7eb;
    font-size: 9pt;
    color: #6b7280;
}
QProgressBar#CoreBar {
    background-color: #e5e7eb;
    border: none;
    border-radius: 3px;
    height: 6px;
}
QProgressBar#CoreBar::chunk { background: #6366f1; border-radius: 3px; }
QProgressBar#UsageBar {
    background-color: #f3f4f6;
    border: none;
    border-radius: 4px;
    height: 8px;
}

/* ── Scroll areas ── */
QScrollArea { background-color: transparent; border: none; }

/* ── Splitters ── */
QSplitter::handle { background-color: #e5e7eb; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

/* ── Dialog / MessageBox ── */
QDialog { background-color: #f5f6fa; }
QMessageBox { background-color: #ffffff; }
QDialogButtonBox QPushButton { min-width: 80px; }

/* ── Context menu ── */
QMenu#ContextMenu {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 5px;
    font-size: 10pt;
}
QMenu#ContextMenu::item { padding: 7px 18px; border-radius: 5px; color: #1f2937; }
QMenu#ContextMenu::item:selected { background-color: #eef2ff; color: #4f46e5; }
QMenu#ContextMenu::separator { height: 1px; background-color: #f3f4f6; margin: 3px 8px; }

/* ── Tab panels header ── */
QWidget#TabHeader {
    background-color: #ffffff;
    border-bottom: 2px solid #e5e7eb;
}
QWidget#FilterBar {
    background-color: #fafafa;
    border-bottom: 1px solid #e5e7eb;
}
QWidget#ActionBar {
    background-color: #ffffff;
    border-bottom: 1px solid #f3f4f6;
}

/* ── Info cards ── */
QFrame#InfoCard {
    background-color: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
}
QFrame#InfoCard:hover { border-color: #c7d2fe; }

/* ── Chart panels ── */
QFrame#ChartCard {
    background-color: #ffffff;
    border: 1.5px solid #e5e7eb;
    border-radius: 12px;
}

/* ── Alert items ── */
QFrame#AlertItem { border-radius: 6px; }

/* ── Vertical nav separator ── */
QFrame#VSep { background-color: #e5e7eb; }
